# Copy to .env (optional). Everything works with defaults.

# Without a key the service still calls Anthropic (gets 401) and uses a static
# draft with a realistic 5–30 s delay.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Base URL used in knowledge-base links inside drafts.
PUBLIC_BASE_URL=http://localhost:8000

# If set, the webhook requires header `X-Webhook-Secret: <value>`.
WEBHOOK_SECRET=
# If set, the operator UI/API requires HTTP Basic auth: operator / <value>.
OPERATOR_PASSWORD=

# Helpdesk mock flakiness: share of 503 responses and of slow (15 s) responses.
MOCK_FAIL_RATE=0.2
MOCK_SLOW_RATE=0.1
